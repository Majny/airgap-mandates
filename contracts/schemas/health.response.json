{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/health.response.json",
  "title": "health.response",
  "type": "object",
  "properties": {
    "status": {
      "const": "ok"
    },
    "backend": {
      "enum": [
        "memory",
        "moto",
        "aws"
      ]
    },
    "deployment": {
      "type": "string",
      "pattern": "^[A-Z0-9]{1,5}$"
    },
    "demo_profile": {
      "enum": [
        "demo",
        "prod"
      ]
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "render_profile": {
      "enum": [
        "safe3-mono-16x4",
        "safe5-mono-18x7"
      ]
    },
    "code_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "log_origin": {
      "type": "string"
    },
    "log_pubkey_id": {
      "type": "string"
    },
    "log_vkey": {
      "type": "string"
    },
    "w1_vkey": {
      "type": "string"
    },
    "w2_vkey": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "backend",
    "deployment",
    "demo_profile",
    "policy_hash",
    "render_profile",
    "code_sha256",
    "log_origin",
    "log_pubkey_id",
    "log_vkey",
    "w1_vkey",
    "w2_vkey"
  ],
  "additionalProperties": false
}
