{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/health.response.json",
  "title": "health.response",
  "type": "object",
  "properties": {
    "status": {
      "const": "ok"
    },
    "backend": {
      "enum": [
        "memory",
        "moto",
        "aws"
      ]
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "render_width": {
      "type": "integer"
    }
  },
  "required": [
    "status",
    "backend",
    "policy_hash",
    "render_width"
  ],
  "additionalProperties": false
}
