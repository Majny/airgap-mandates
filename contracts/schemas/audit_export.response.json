{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/audit_export.response.json",
  "title": "audit_export.response",
  "type": "object",
  "properties": {
    "log_id": {
      "enum": [
        "audit",
        "attest"
      ]
    },
    "redacted": {
      "type": "boolean"
    },
    "leaves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "$ref": "common.json#/$defs/audit_event"
          },
          "leaf_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "seq",
          "event",
          "leaf_hash"
        ],
        "additionalProperties": false
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\n]+\\n[0-9]+\\n[A-Za-z0-9+/=]+\\n(.*\\n)*\\n(— [^ \\n]+ [A-Za-z0-9+/=]+\\n)+$"
      }
    },
    "pubkeys": {
      "type": "object",
      "properties": {
        "log": {
          "type": "string"
        },
        "w1": {
          "type": "string"
        },
        "w2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "log",
        "w1",
        "w2"
      ],
      "additionalProperties": false
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "role": {
            "enum": [
              "clerk",
              "treasury"
            ]
          },
          "device": {
            "enum": [
              "GENUINE",
              "EMULATOR"
            ]
          },
          "enroll_seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "address",
          "role",
          "device",
          "enroll_seq"
        ],
        "additionalProperties": false
      }
    },
    "policies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cedar_policies_text": {
            "type": "string"
          },
          "cedar_schema": {
            "type": "object"
          },
          "translit_table": {
            "type": "object"
          },
          "fact_severity_table": {
            "type": "object"
          },
          "params": {
            "type": "object"
          },
          "policy_v": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "cedar_policies_text",
          "cedar_schema",
          "translit_table",
          "fact_severity_table",
          "params",
          "policy_v"
        ],
        "additionalProperties": false
      }
    },
    "snapshots": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "render_profile": {
      "const": "safe5-mono-18x7"
    }
  },
  "required": [
    "log_id",
    "redacted",
    "leaves",
    "checkpoints",
    "pubkeys",
    "approvers",
    "policies",
    "snapshots",
    "render_profile"
  ],
  "additionalProperties": false
}
