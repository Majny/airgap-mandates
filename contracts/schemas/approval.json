{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/approval.json",
  "title": "approval",
  "type": "object",
  "properties": {
    "nonce": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "sig": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$"
    },
    "displayed_text": {
      "type": "string"
    },
    "device": {
      "enum": [
        "GENUINE",
        "EMULATOR"
      ]
    }
  },
  "required": [
    "nonce",
    "address",
    "sig",
    "displayed_text",
    "device"
  ],
  "additionalProperties": false
}
