{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/change_create.request.json",
  "title": "change_create.request",
  "type": "object",
  "properties": {
    "vendor_ico": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "new_iban": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$"
    },
    "email_id": {
      "type": "string"
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/hint"
      }
    }
  },
  "required": [
    "vendor_ico",
    "new_iban"
  ],
  "additionalProperties": false
}
