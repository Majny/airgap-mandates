{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/change_create.request.json",
  "title": "change_create.request",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "pattern": "^ven_[0-9]{8}$"
    },
    "new_iban": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$"
    },
    "email_id": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/hint"
      }
    },
    "session_id": {
      "type": "string"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "vendor_id",
    "new_iban"
  ],
  "additionalProperties": false
}
