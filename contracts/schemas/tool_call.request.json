{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/tool_call.request.json",
  "title": "tool_call.request",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "args": {
      "type": "object"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "session_id",
    "step",
    "args",
    "manifest_sha256"
  ],
  "additionalProperties": false
}
