{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airgap.local/schemas/attestation_create.request.json",
  "title": "attestation_create.request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "propose"
        },
        "ico": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "iban": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$"
        },
        "valid_from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "change_id": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "ico",
        "iban",
        "valid_from",
        "supersedes",
        "change_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "revoke"
        },
        "ico": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "revokes_v": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "action",
        "ico",
        "revokes_v"
      ],
      "additionalProperties": false
    }
  ]
}
