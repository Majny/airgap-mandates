# AirGap Mandates operations console (host/ui.py), read-only toward the executor, behind the bank's SSO.
# Docs: docs/BANK-READINESS.md "Running the console". Build: docker build -f Dockerfile.console -t airgap-console .
#
# No secrets in the image. At run time mount:
#   /app/.streamlit/secrets.toml   [auth] OIDC client (sample in docs/BANK-READINESS.md), read-only
# and pass AIRGAP_EXECUTOR_URL, AIRGAP_UI_OPERATORS, AIRGAP_UI_AUDITORS and AWS credentials that may assume the
# airgap-host / airgap-auditor roles (task role or instance profile; never baked in).
# No trezorlib: the console never signs. Approvers sign on their own Trezor through host/signer.py elsewhere.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system --gid 10001 console && useradd --system --uid 10001 --gid console --home /app console

WORKDIR /app
COPY pyproject.toml README.md ./
COPY executor executor
COPY host host
COPY witness witness
COPY tools tools
COPY infra/__init__.py infra/aws_e2e.py infra/
COPY infra/evidence infra/evidence
COPY bench bench
COPY vendor vendor
COPY agent agent
COPY demo demo
COPY contracts contracts
COPY data data
COPY .streamlit/config.toml .streamlit/config.toml

# Runtime deps of the executor package (read-only helpers: receipts, verify_audit, pain.001 hash check) plus
# Streamlit with its OIDC extra (Authlib). The [ui] extra is not used: it carries playwright for the visual test.
RUN pip install . "streamlit[auth]==1.66.0" segno \
 && chown -R console:console /app/.streamlit

USER console
EXPOSE 8501
ENV AIRGAP_UI_REQUIRE_SSO=1 \
    AIRGAP_UI_REFRESH_S=10 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_CLIENT_TOOLBAR_MODE=minimal

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4).status == 200 else 1)"

CMD ["streamlit", "run", "host/ui.py"]
